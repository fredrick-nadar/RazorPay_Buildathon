# ARGUS CONTROL — local configuration template.
# Names only. Never put real values or secrets in this file or in any committed file.
# Every variable is optional; with none set, the application starts in rules-only
# mode against a local SQLite database.

# Local SQLite database file (created on first start; ignored by git).
# Default when unset: argus.local.sqlite3
ARGUS_DB_PATH=

# Optional structured-output model provider. Leave empty for rules-only mode.
ARGUS_MODEL_PROVIDER=

# Optional model API key. Leave empty for rules-only mode. Never commit a real key.
ARGUS_MODEL_API_KEY=

# Local server binding. Defaults when unset: host 127.0.0.1, port 8000,
# log level INFO.
ARGUS_HOST=
ARGUS_PORT=
ARGUS_LOG_LEVEL=
