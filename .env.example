# ARGUS CONTROL — local configuration template.
# Names only. Never put real values or secrets in this file or in any committed file.
# Every variable is optional; with none set, the application starts in rules-only
# mode against a local SQLite database.

# Local SQLite database file (created on first start; ignored by git).
# Default when unset: argus.local.sqlite3
ARGUS_DB_PATH=

# Optional structured-output model provider. Leave empty for rules-only mode.
ARGUS_MODEL_PROVIDER=

# Optional model API key. Leave empty for rules-only mode. Never commit a real key.
ARGUS_MODEL_API_KEY=

# Local server binding. Defaults when unset: host 127.0.0.1, port 8000,
# log level INFO.
ARGUS_HOST=
ARGUS_PORT=
ARGUS_LOG_LEVEL=

# Optional Razorpay Test Mode read-only client (Phase 6). Names only - never
# put real values here. With these unset, the client skips gracefully and the
# synthetic offline adapter remains the only integration path.
ARGUS_RAZORPAY_KEY_ID=
ARGUS_RAZORPAY_KEY_SECRET=
ARGUS_RAZORPAY_WEBHOOK_SECRET=

# Optional voice speech providers (Sarvam-compatible; PRD 13.5.3). Names only.
# Unset = /voice/transcribe and /voice/tts return 501 and the copilot uses
# on-device browser speech. No voice capability is required for any gate.
ARGUS_VOICE_STT_API_KEY=
ARGUS_VOICE_TTS_API_KEY=

# AI investigator chain (PRD 10). ARGUS_AI_PROVIDER: auto | gemini | openai |
# sarvam | ollama | fake | none. "auto" tries configured cloud keys in order
# (Gemini -> OpenAI -> Sarvam-M), then local Ollama when ARGUS_OLLAMA_ENABLED
# is true, then falls back to the deterministic fake provider. Unset keys are
# fine - every gate passes without any AI provider.
ARGUS_AI_PROVIDER=
ARGUS_GEMINI_API_KEY=
ARGUS_OPENAI_API_KEY=
ARGUS_SARVAM_API_KEY=
ARGUS_OLLAMA_ENABLED=
ARGUS_OLLAMA_MODEL=
