# Copy to .env.local. Keep every real credential out of source control.

# Razorpay Test Mode diagnostics. Imports also accept request-scoped credentials.
ARGUS_RAZORPAY_KEY_ID=
ARGUS_RAZORPAY_KEY_SECRET=

# AI investigator and optional voice/fallback providers.
ARGUS_GROQ_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

