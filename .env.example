# ARGUS CONTROL — local configuration template.
# Names only. Never put real values or secrets in this file or in any committed file.
# Every variable is optional; with none set, the application starts in rules-only
# mode against a local SQLite database.

# Local SQLite database file (created on first start; ignored by git).
# Default when unset: argus.local.sqlite3
ARGUS_DB_PATH=
ARGUS_IMPORT_STAGING_ROOT=

# Optional Groq key for bounded CSV schema mapping and the existing investigator.
# The key stays server-side. Groq proposes header mappings only; deterministic
# code validates and applies them.
ARGUS_GROQ_API_KEY=
ARGUS_GROQ_SCHEMA_MODEL=
ARGUS_GROQ_INVESTIGATOR_MODEL=

# Investigator deadline hierarchy. The rule is:
#   attempt cap  <=  model-turn window  <=  total case deadline
# Each attempt actually receives min(cap, time left before the case deadline),
# so a stuck provider cannot consume the budget its fallback needs.
# One HTTP attempt (seconds). Default 11.
ARGUS_AI_TIMEOUT_S=
# One model turn, including provider fallback within it. Default 25.
ARGUS_INVESTIGATOR_TURN_TIMEOUT_S=
# Whole case: every turn, retry, provider attempt and fallback. Default 75.
ARGUS_INVESTIGATOR_TIMEOUT_S=
# Withheld from each attempt so a failure can be classified. Default 0.75.
ARGUS_INVESTIGATOR_SAFETY_RESERVE_S=
# Shortest attempt worth starting. Default 1.5.
ARGUS_INVESTIGATOR_MIN_ATTEMPT_S=
# Last-resort worker grace over the case deadline. Default 5.
ARGUS_INVESTIGATOR_WATCHDOG_GRACE_S=
# Attempts per provider before falling through. Default 1: two 11-second
# attempts inside a 25-second turn left a fallback provider ~2 seconds, which
# is not a usable attempt. Raising this stays safe because the reserve below
# holds back a full attempt for the next provider.
ARGUS_AI_PROVIDER_MAX_ATTEMPTS=
# Wall time reserved inside a turn for the providers AFTER the current one.
# Unset means one full attempt cap; clamped so a first attempt stays viable.
ARGUS_INVESTIGATOR_FALLBACK_RESERVE_S=
# Require one allowlisted read-only evidence tool call before a live model's
# final answer is accepted. Default true; keep it on.
ARGUS_INVESTIGATOR_REQUIRE_TOOL_CALL=

# Universal AI LLM API Key for the existing provider chain.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional legacy structured-output model provider. Leave empty for rules-only mode.
ARGUS_MODEL_PROVIDER=
ARGUS_MODEL_API_KEY=

# Local server binding. Defaults when unset: host 127.0.0.1, port 8000,
# log level INFO.
ARGUS_HOST=
ARGUS_PORT=
ARGUS_LOG_LEVEL=

# Optional Razorpay Test Mode read-only client (Phase 6). Names only - never
# put real values here. With these unset, the client skips gracefully and the
# synthetic offline adapter remains the only integration path.
ARGUS_RAZORPAY_KEY_ID=
ARGUS_RAZORPAY_KEY_SECRET=
ARGUS_RAZORPAY_WEBHOOK_SECRET=

# Optional Telegram channel. Local development uses outbound long polling, so
# no public URL, webhook or object storage is required. Create the token with
# @BotFather and never paste Razorpay credentials into Telegram.
ARGUS_TELEGRAM_ENABLED=
ARGUS_TELEGRAM_BOT_TOKEN=
ARGUS_TELEGRAM_POLL_TIMEOUT_S=
ARGUS_TELEGRAM_PAIRING_TTL_S=

# Optional voice speech providers (Sarvam-compatible; PRD 13.5.3). Names only.
# Unset = /voice/transcribe and /voice/tts return 501 and the copilot uses
# on-device browser speech. No voice capability is required for any gate.
ARGUS_VOICE_STT_API_KEY=
ARGUS_VOICE_TTS_API_KEY=

# AI investigator chain (PRD 10). ARGUS_AI_PROVIDER: auto | groq | gemini |
# openai | sarvam | ollama | fake | none. "auto" tries configured cloud keys
# in order (Groq -> Gemini -> OpenAI -> Sarvam-M), then local Ollama when
# ARGUS_OLLAMA_ENABLED is true. Fake investigation must be selected explicitly.
# Unset keys are fine: rules-only mode remains available.
ARGUS_AI_PROVIDER=
ARGUS_GEMINI_API_KEY=
ARGUS_OPENAI_API_KEY=
ARGUS_SARVAM_API_KEY=
ARGUS_OLLAMA_ENABLED=
ARGUS_OLLAMA_MODEL=
